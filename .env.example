# GastoClaro — Variables de entorno
# ═══════════════════════════════════════════

# Servidor
PORT=3001
NODE_ENV=development

# Base de datos — PostgreSQL en Supabase
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
